NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# PostgreSQL
DATABASE_URL="postgresql://stocktify:stocktify_password@localhost:5432/stocktify_db?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Security & JWT
JWT_SECRET="your_jwt_secret_key_change_in_production"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key_change_in_production"
COOKIE_SECRET="your_cookie_secret_key_change_in_production"

# CORS
CORS_ORIGINS="http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173"

# Upstream Market Data
YAHOO_BASE_URL="https://query1.finance.yahoo.com"
YAHOO_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36"

# LINE Messaging & Login (可留空，若未設定則使用測試模擬模式)
LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET=""
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_OAUTH_REDIRECT_URI="http://localhost:8080/api/v1/line/oauth/callback"
FRONTEND_URL="http://localhost:5173"
